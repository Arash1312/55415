#!/usr/bin/env python3

"""
Klyro
-----
Minimal HTTP endpoint inspector for developers.

Features:
- Check one or multiple URLs
- HTTP status detection
- Response time measurement
- Response size
- Redirect support
- Configurable timeout
- Clean terminal output
- No external dependencies

Usage:
    python klyro.py https://example.com
    python klyro.py https://example.com https://github.com
    python klyro.py https://example.com --timeout 5
"""

from __future__ import annotations

import argparse
import sys
import time
import urllib.error
import urllib.request
from dataclasses import dataclass
from typing import Iterable


USER_AGENT = "Klyro/1.0"
DEFAULT_TIMEOUT = 10


@dataclass
class CheckResult:
    url: str
    status: int | None
    elapsed_ms: float
    size: int
    error: str | None = None

    @property
    def ok(self) -> bool:
        return self.error is None and self.status is not None and 200 <= self.status < 400


def check_url(url: str, timeout: float) -> CheckResult:
    if not url.startswith(("http://", "https://")):
        url = f"https://{url}"

    request = urllib.request.Request(
        url,
        headers={
            "User-Agent": USER_AGENT,
            "Accept": "*/*",
        },
    )

    start = time.perf_counter()

    try:
        with urllib.request.urlopen(
            request,
            timeout=timeout,
        ) as response:
            body = response.read()

            elapsed = (time.perf_counter() - start) * 1000

            return CheckResult(
                url=url,
                status=response.status,
                elapsed_ms=elapsed,
                size=len(body),
            )

    except urllib.error.HTTPError as exc:
        elapsed = (time.perf_counter() - start) * 1000

        return CheckResult(
            url=url,
            status=exc.code,
            elapsed_ms=elapsed,
            size=0,
            error=f"HTTP {exc.code}",
        )

    except urllib.error.URLError as exc:
        elapsed = (time.perf_counter() - start) * 1000

        return CheckResult(
            url=url,
            status=None,
            elapsed_ms=elapsed,
            size=0,
            error=str(exc.reason),
        )

    except TimeoutError:
        elapsed = (time.perf_counter() - start) * 1000

        return CheckResult(
            url=url,
            status=None,
            elapsed_ms=elapsed,
            size=0,
            error="Connection timed out",
        )

    except Exception as exc:
        elapsed = (time.perf_counter() - start) * 1000

        return CheckResult(
            url=url,
            status=None,
            elapsed_ms=elapsed,
            size=0,
            error=str(exc),
        )


def format_size(size: int) -> str:
    if size < 1024:
        return f"{size} B"

    if size < 1024 * 1024:
        return f"{size / 1024:.1f} KB"

    return f"{size / (1024 * 1024):.1f} MB"


def print_result(result: CheckResult) -> None:
    if result.ok:
        state = "UP"
        status = str(result.status)
    elif result.status is not None:
        state = "DOWN"
        status = str(result.status)
    else:
        state = "DOWN"
        status = "---"

    print(
        f"{state:<6}"
        f"{status:<6}"
        f"{result.elapsed_ms:>9.1f} ms  "
        f"{format_size(result.size):>10}  "
        f"{result.url}"
    )

    if result.error:
        print(f"      error: {result.error}")


def run(urls: Iterable[str], timeout: float) -> int:
    print()
    print("Klyro endpoint inspector")
    print("-" * 72)
    print(
        f"{'STATE':<6}"
        f"{'HTTP':<6}"
        f"{'TIME':>12}  "
        f"{'SIZE':>10}  "
        f"URL"
    )
    print("-" * 72)

    failed = 0

    for url in urls:
        result = check_url(url, timeout)
        print_result(result)

        if not result.ok:
            failed += 1

    print("-" * 72)
    print(f"Checked: {len(list(urls)) if not isinstance(urls, list) else len(urls)}")
    print()

    return 1 if failed else 0


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Minimal HTTP endpoint inspector."
    )

    parser.add_argument(
        "urls",
        nargs="+",
        help="URL or hostname to inspect.",
    )

    parser.add_argument(
        "--timeout",
        type=float,
        default=DEFAULT_TIMEOUT,
        help=f"Request timeout in seconds. Default: {DEFAULT_TIMEOUT}",
    )

    return parser.parse_args()


def main() -> int:
    args = parse_args()

    if args.timeout <= 0:
        print("Error: timeout must be greater than zero.", file=sys.stderr)
        return 2

    return run(args.urls, args.timeout)


if __name__ == "__main__":
    raise SystemExit(main())
